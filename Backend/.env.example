# 실제 값은 로컬 .env 또는 배포 환경변수에만 넣고, 이 파일에는 넣지 않습니다.
CLAIM_REVIEW_COPILOT_PROVIDER=blocked
CLAIM_REVIEW_COPILOT_BASE_URL=
CLAIM_REVIEW_COPILOT_MODEL=
CLAIM_REVIEW_COPILOT_API_KEY=
CLAIM_REVIEW_COPILOT_TIMEOUT=10s
CLAIM_REVIEW_COPILOT_ALLOW_EXTERNAL_CALLS=false

# 결제는 기본 fake adapter로 동작합니다. Toss 테스트 결제 시에만 PAYMENT_GATEWAY=toss로 전환합니다.
PAYMENT_GATEWAY=fake
TOSS_PAYMENTS_BASE_URL=https://api.tosspayments.com
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_TIMEOUT=10s
TOSS_PAYMENTS_ALLOW_LIVE_KEY=false

# 감사 로그 물리 삭제는 기본 비활성입니다. 실제 보존 기간 정책을 승인한 환경에서만 true로 전환합니다.
AUDIT_RETENTION_ENABLED=false
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_CRON=0 30 3 * * *
AUDIT_RETENTION_ZONE=Asia/Seoul
