<!-- #Demo Setting -->
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.capsule.insurance.insurer.infra.InsurerCatalogMapper">

    <resultMap id="referenceCoverageResultMap" type="com.capsule.insurance.insurer.domain.ReferenceCoverage">
        <id property="coverageCode" column="coverage_code"/>
        <result property="coverageCategory" column="coverage_category_code"/>
        <result property="coverageName" column="coverage_name"/>
        <result property="duplicateGroupCode" column="duplicate_group_code"/>
        <result property="description" column="description"/>
        <result property="searchKeywordsJson" column="search_keywords_json"/>
        <result property="active" column="is_active"/>
        <result property="compensationType" column="compensation_type"/>
        <result property="duplicateRuleCode" column="duplicate_rule_code"/>
        <result property="recommendationRuleCode" column="recommendation_rule_code"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="productSourceResultMap" type="com.capsule.insurance.insurer.dto.ProductSummaryResponse">
        <constructor>
            <idArg column="product_source_id" javaType="java.lang.Long"/>
            <arg column="company_name" javaType="java.lang.String"/>
            <arg column="product_name" javaType="java.lang.String"/>
            <arg column="insurer_sector" javaType="com.capsule.insurance.insurer.domain.InsurerSector"/>
            <arg column="coverage_category_code" javaType="java.lang.String"/>
            <arg column="coverage_code" javaType="java.lang.String"/>
            <arg column="monthly_price" javaType="java.math.BigDecimal"/>
            <arg column="loaded_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap id="productDetailResultMap" type="com.capsule.insurance.insurer.dto.ProductDetailResponse">
        <constructor>
            <idArg column="product_source_id" javaType="java.lang.Long"/>
            <arg column="company_name" javaType="java.lang.String"/>
            <arg column="product_name" javaType="java.lang.String"/>
            <arg column="insurer_sector" javaType="com.capsule.insurance.insurer.domain.InsurerSector"/>
            <arg column="sale_channel" javaType="java.lang.String"/>
            <arg column="coverage_name" javaType="java.lang.String"/>
            <arg column="claim_reason" javaType="java.lang.String"/>
            <arg column="payout_amount" javaType="java.lang.String"/>
            <arg column="join_amount" javaType="java.lang.String"/>
            <arg column="minimum_join_premium" javaType="java.lang.String"/>
            <arg column="payment_cycle" javaType="java.lang.String"/>
            <arg column="payment_term" javaType="java.lang.String"/>
            <arg column="coverage_term" javaType="java.lang.String"/>
            <arg column="coverage_category_code" javaType="java.lang.String"/>
            <arg column="coverage_code" javaType="java.lang.String"/>
            <arg column="monthly_price" javaType="java.math.BigDecimal"/>
            <arg column="product_summary" javaType="java.lang.String"/>
            <arg column="product_feature" javaType="java.lang.String"/>
            <arg column="special_note" javaType="java.lang.String"/>
            <arg column="contact_phone" javaType="java.lang.String"/>
            <arg column="sale_date" javaType="java.time.LocalDate"/>
            <arg column="current_announced_rate" javaType="java.lang.String"/>
            <arg column="fixed_rate" javaType="java.lang.String"/>
            <arg column="minimum_guaranteed_rate" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="capsuleProductResultMap" type="com.capsule.insurance.insurer.domain.CapsuleProduct">
        <id property="capsuleProductId" column="capsule_product_id"/>
        <result property="productName" column="product_name"/>
        <result property="companyName" column="company_name"/>
        <result property="coverageCategory" column="coverage_category_code"/>
        <result property="coverageName" column="coverage_name"/>
        <result property="coverageAmount" column="coverage_amount"/>
        <result property="monthlyPriceMale" column="monthly_price_male"/>
        <result property="monthlyPriceFemale" column="monthly_price_female"/>
        <result property="saleStatus" column="sale_status"/>
        <result property="duplicateCheckTarget" column="is_duplicate_check_target"/>
        <result property="termsUri" column="terms_uri"/>
        <result property="termsVersion" column="terms_version"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findActiveCoverages" resultMap="referenceCoverageResultMap">
        select
            coverage_code,
            coverage_category_code,
            coverage_name,
            duplicate_group_code,
            description,
            search_keywords_json,
            is_active,
            compensation_type,
            duplicate_rule_code,
            recommendation_rule_code,
            created_at,
            updated_at
        from ref_coverage
        where is_active = true
        order by coverage_code
    </select>

    <!-- TODO: 이 파트에서 HIDDEN/DISCONTINUED 상품을 어떤 조회에서 노출할지라는 논의점이 있는데, 우선 AVAILABLE 상품만 목록 조회하도록 구현했음. -->
    <select id="findAvailableCapsuleProducts" resultMap="capsuleProductResultMap">
        select
            capsule_product_id,
            capsule_code,
            product_name,
            company_name,
            insurer_sector,
            coverage_category_code,
            coverage_code,
            coverage_amount,
            coverage_unit,
            monthly_price_male,
            monthly_price_female,
            min_retention_days,
            sale_status,
            is_duplicate_check_target,
            terms_uri,
            terms_version,
            description,
            created_at,
            updated_at
        from capsule_product
        where sale_status = 'AVAILABLE'
        order by capsule_product_id
    </select>

    <select id="findCapsuleProductById" resultMap="capsuleProductResultMap">
        select
            capsule_product_id,
            capsule_code,
            product_name,
            company_name,
            insurer_sector,
            coverage_category_code,
            coverage_code,
            coverage_amount,
            coverage_unit,
            monthly_price_male,
            monthly_price_female,
            min_retention_days,
            sale_status,
            is_duplicate_check_target,
            terms_uri,
            terms_version,
            description,
            created_at,
            updated_at
        from capsule_product
        where capsule_product_id = #{capsuleProductId}
    </select>

    <select id="findProductSourcesByFilter" resultMap="productSourceResultMap">
        SELECT
            product_source_id,
            company_name,
            product_name,
            insurer_sector::text as insurer_sector,
            coverage_category_code::text as coverage_category_code,
            coverage_code,
            <choose>
                <when test="gender == 'M'.toString()">monthly_premium_male</when>
                <when test="gender == 'F'.toString()">monthly_premium_female</when>
                <otherwise>NULL</otherwise>
            </choose> AS monthly_price,
            loaded_at,
            updated_at
        FROM insurance.product_source
        WHERE 1=1
        <if test="category != null and category != ''">
            AND coverage_category_code = #{category}::insurance.coverage_category_code
        </if>
        <choose>
            <when test="gender == 'M'.toString()">
                AND (monthly_premium_male IS NOT NULL AND monthly_premium_male > 0)
                <if test="maxPrice != null">
                    AND monthly_premium_male &lt;= #{maxPrice}
                </if>
            </when>
            <when test="gender == 'F'.toString()">
                AND (monthly_premium_female IS NOT NULL AND monthly_premium_female > 0)
                <if test="maxPrice != null">
                    AND monthly_premium_female &lt;= #{maxPrice}
                </if>
            </when>
        </choose>
        ORDER BY product_source_id ASC
    </select>
    <select id="findProductSourceDetail" resultMap="productDetailResultMap">
        SELECT
            product_source_id,
            company_name,
            product_name,
            insurer_sector::text as insurer_sector,
            sale_channel,
            coverage_name,
            claim_reason,
            payout_amount,
            join_amount,
            minimum_join_premium,
            payment_cycle,
            payment_term,
            coverage_term,
            coverage_category_code::text as coverage_category_code,
            coverage_code,
            CASE 
                WHEN #{gender} = 'M' THEN monthly_premium_male
                WHEN #{gender} = 'F' THEN monthly_premium_female
                ELSE 0.00
            END as monthly_price,
            product_summary,
            product_feature,
            special_note,
            contact_phone,
            sale_date,
            current_announced_rate,
            fixed_rate,
            minimum_guaranteed_rate
        FROM insurance.product_source
        WHERE product_source_id = #{productSourceId}
    </select>
</mapper>
